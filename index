rid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}.mini{background:#0b1320;border:1px solid var(--line);border-radius:12px;padding:13px}.mini span{display:block;color:#cbd5e1;font-size:12px}.mini strong{display:block;font-size:24px;margin-top:6px}.charts{display:grid;grid-template-columns:1.35fr .8fr;gap:18px;margin-top:18px}.chart-box{padding:18px;min-height:270px}.chart-box h3{margin:0 0 14px}.canvas-wrap{height:210px;position:relative}.bottom-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.stat-card{background:#0b1320;border:1px solid var(--line);border-radius:13px;padding:16px}.stat-card label{display:block;color:#cbd5e1}.stat-card strong{font-size:28px;display:block;margin-top:8px}.section{display:none}.section.active{display:block}.table{width:100%;border-collapse:collapse}.table td,.table th{border-bottom:1px solid var(--line);padding:12px;text-align:left}.table th{color:#cbd5e1}.hide{display:none!important}@media(max-width:1100px){.app{grid-template-columns:1fr}.sidebar{position:relative;height:auto}.streak-box{position:relative;left:auto;right:auto;bottom:auto;margin-top:20px}.grid,.calendar-wrap,.charts{grid-template-columns:1fr}.kpis{min-width:0}.topbar{flex-direction:column;align-items:stretch}.mini-cards,.bottom-cards{grid-template-columns:1fr 1fr}}@media(max-width:700px){.kpis{grid-template-columns:1fr}.mini-cards,.bottom-cards{grid-template-columns:1fr}.main{padding:12px}}
