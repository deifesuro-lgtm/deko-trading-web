<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><img src="assets/deko-logo.jpeg" onerror="this.style.display='none'"><div class="brand-title">DEKO</div><div class="brand-sub">TRADING</div></div>
    <nav class="nav">
      <button class="active" data-tab="dashboard">▦ Dashboard</button><button data-tab="calendario">▣ Calendario</button><button data-tab="registro">▤ Registro Diario</button><button data-tab="metricas">↗ Métricas</button><button data-tab="analisis">◉ Análisis</button><button data-tab="notas">✎ Notas</button>
    </nav>
    <div class="streak-box"><small>🔥 Racha Actual</small><strong id="sideStreak">0 días</strong><small id="sideBest">Mejor racha: 0 días</small></div>
  </aside>
  <main class="main">
    <div class="topbar"><div class="hello"><h1>Hola, Diego Suarez 👋</h1><p>Disciplina hoy, libertad mañana. <span class="dot"></span></p></div><div class="kpis"><div class="kpi"><div><label>Trader Score</label><strong id="kpiScore">0/100</strong></div><canvas class="spark" id="spark1"></canvas></div><div class="kpi"><div><label>Acertabilidad</label><strong id="kpiAsert">0%</strong></div><canvas class="spark" id="spark2"></canvas></div><div class="kpi orange"><div><label>Efectividad</label><strong id="kpiEfec">0%</strong></div><canvas class="spark" id="spark3"></canvas></div></div></div>
    <section id="dashboard" class="section active">
      <div class="grid"><div>
        <div class="panel pad calendar-wrap"><div><div class="cal-head"><h2>Calendario</h2><div class="cal-tools"><input type="month" id="month"><input type="date" id="date"></div></div><div class="calendar" id="cal"></div><div class="legend"><span><b class="lg" style="background:var(--green)"></b>Día positivo</span><span><b class="lg" style="background:var(--orange)"></b>Break even</span><span><b class="lg" style="background:var(--red)"></b>Día negativo</span><span><b class="lg" style="background:#334155"></b>Sin operar</span></div></div><div class="monthly"><h3>Resumen del Mes</h3><div id="monthRows"></div></div></div>
        <div class="panel detail"><div class="detail-head"><h2 id="detailTitle">Detalle del día</h2><span class="pill" id="dayPill">Sin operar</span></div><img class="trade-img" id="img"><div class="empty-img" id="emptyImg">Sin imagen para este día</div><div class="notes" id="dayNotes">Selecciona un día o guarda tu operativa.</div><div class="mini-cards"><div class="mini"><span>Trades con manto</span><strong class="g" id="mantoCount">0</strong><span id="mantoEfec">0% efectividad</span></div><div class="mini"><span>Trades sin manto</span><strong class="r" id="noMantoCount">0</strong><span id="noMantoEfec">0% efectividad</span></div><div class="mini"><span>Mejor sesión</span><strong id="bestSession">—</strong><span id="bestSessionPts">0 pts</span></div><div class="mini"><span>Mejor entrada</span><strong id="bestEntry">—</strong><span id="bestEntryEfec">0%</span></div></div></div>
        <div class="charts"><div class="panel chart-box"><h3>Evolución del Trader Score</h3><div class="canvas-wrap"><canvas id="lineChart"></canvas></div></div><div class="panel chart-box"><h3>Distribución de Resultados</h3><div class="canvas-wrap"><canvas id="donutChart"></canvas></div><div id="donutLegend"></div></div></div>
        <div class="bottom-cards"><div class="stat-card"><label>🏆 Mejor Día</label><strong class="g" id="bestDay">—</strong><small id="bestDayDate">—</small></div><div class="stat-card"><label>🏆 Peor Día</label><strong class="r" id="worstDay">—</strong><small id="worstDayDate">—</small></div><div class="stat-card"><label>🔥 Mayor Racha Ganadora</label><strong class="g" id="bestWinStreak">0 días</strong><small id="bestWinRange">—</small></div><div class="stat-card"><label>🔥 Mayor Racha Negadora</label><strong class="r" id="bestLossStreak">0 días</strong><small id="bestLossRange">—</small></div></div>
      </div><aside class="panel pad form" id="rightForm"><h2>Registrar Día</h2><div class="field"><label>Resultado del día</label><div class="seg" id="resultadoSeg"><button data-v="Target">Positivo</button><button data-v="Stop Loss">Negativo</button><button data-v="Break Even">Break Even</button></div></div><div class="field"><label>Dirección</label><select id="direccion"><option value="">Seleccionar</option><option>Largo</option><option>Corto</option><option>Compra</option><option>Venta</option></select></div><div class="field"><label>Entrada</label><select id="entrada"><option value="">Seleccionar</option><option>Pullback a EMA9</option><option>Ruptura</option><option>Largo</option><option>Corto</option></select></div><div class="field"><label>Relación</label><select id="relacion"><option>2:1</option><option>1:1</option><option>BE</option></select></div><div class="field"><label>Puntos</label><input id="puntos" type="number" step="0.01" placeholder="Ej: 2.3 o -1.5"></div><div class="field"><label>Sesión</label><select id="sesion"><option>New York</option><option>London</option></select></div><div class="field"><label>Gestión</label><select id="gestion"><option value="">Seleccionar</option><option>Ejecutado</option><option>Ejecutada correctamente</option><option>Mal usado</option></select></div><div class="field"><label>Feeling</label><select id="feeling"><option value="">Seleccionar</option><option>Venganza</option><option>FOMO</option><option>Ansiedad</option><option>Neutro</option><option>Certeza</option><option>Profesional</option><option>Profesional / Certeza</option></select></div><div class="field"><label>¿Cumplió el Manto?</label><div class="switch" id="mantoSwitch"><button data-v="Si">Sí</button><button data-v="No">No</button></div></div><div class="field"><label>Notas adicionales</label><textarea id="notas" placeholder="Escribe tus notas aquí..."></textarea></div><button class="save" onclick="guardar()">Guardar Día</button></aside></div>
    </section>
    <section id="calendario" class="section"><div class="panel pad"><h2>Calendario</h2><p>Esta vista usa el mismo calendario del dashboard. Vuelve al Dashboard para registrar o revisar días.</p></div></section>
    <section id="registro" class="section"><div class="panel pad"><h2>Registro Diario</h2><p>El formulario principal está en el panel derecho del Dashboard para mantener el flujo rápido.</p></div></section>
    <section id="metricas" class="section"><div class="panel pad"><h2>Métricas Generales</h2><table class="table" id="metricsTable"></table></div></section>
    <section id="analisis" class="section"><div class="panel pad"><h2>Análisis</h2><p id="analysisText">Cuando tengas más días guardados, aquí verás el diagnóstico de fugas: gestión, feeling, manto y sesión.</p></div></section>
    <section id="notas" class="section"><div class="panel pad"><h2>Notas</h2><p>Espacio para futuras notas del proceso.</p></div></section>
  </main>
</div>
<script>
const $=id=>document.getElementById(id); const cal=$('cal'), img=$('img'), emptyImg=$('emptyImg'), monthInput=$('month'), dateInput=$('date'); let selectedResultado='', selectedManto='';
function getImg(date){ const [y,m,d]=date.split('-'); return `assets/operativa/${y}-${d}-${m}_DHTS.png`; }
function allData(){ const arr=[]; for(let i=0;i<localStorage.length;i++){ const k=localStorage.key(i); if(/^\d{4}-\d{2}-\d{2}$/.test(k)){ try{arr.push({date:k,...JSON.parse(localStorage.getItem(k)||'{}')})}catch(e){} } } return arr.sort((a,b)=>a.date.localeCompare(b.date)); }
function points(x){ let p=parseFloat(String(x.puntos||'').replace(',','.')); if(isNaN(p)){ if((x.resultado||'').includes('Target')) return 1; if((x.resultado||'').includes('Stop')) return -1; return 0;} return p; }
function isPos(x){return points(x)>0 || ['Target','Positivo'].includes(x.resultado)} function isNeg(x){return points(x)<0 || ['Stop Loss','Negativo'].includes(x.resultado)} function isBE(x){return (x.resultado||'').includes('Break') || points(x)===0}
function pct(n,d){return d?Math.round(n/d*100):0} function monthData(){ const ym=monthInput.value; return allData().filter(x=>x.date.startsWith(ym));}
function stats(data){ const operated=data.filter(x=>x.resultado||x.puntos||x.manto||x.gestion); const pos=operated.filter(isPos), neg=operated.filter(isNeg), be=operated.filter(isBE); const won=operated.reduce((s,x)=>s+(points(x)>0?points(x):0),0), lost=operated.reduce((s,x)=>s+(points(x)<0?Math.abs(points(x)):0),0); const net=won-lost; const acert=pct(operated.filter(x=>['Si','Sí','si'].includes(x.manto)||isPos(x)||isBE(x)).length,operated.length); const efec=pct(operated.filter(x=>isPos(x)&&!['Venganza','FOMO','Ansiedad'].includes(x.feeling)).length,operated.length); const score=Math.round((acert+efec)/2); return {operated,pos,neg,be,won,lost,net,acert,efec,score}; }
function streaks(data){ const ops=data.filter(x=>x.resultado||x.puntos).sort((a,b)=>a.date.localeCompare(b.date)); let cur=0,bw=0,bl=0,cw=0,cl=0,bwStart='',bwEnd='',blStart='',blEnd='',start=''; ops.forEach(x=>{ if(isPos(x)){ if(cw==0)start=x.date; cw++; cl=0; if(cw>bw){bw=cw;bwStart=start;bwEnd=x.date;} } else if(isNeg(x)){ if(cl==0)start=x.date; cl++; cw=0; if(cl>bl){bl=cl;blStart=start;blEnd=x.date;} } else {cw=0;cl=0;} }); for(let i=ops.length-1;i>=0;i--){ if(isPos(ops[i])) cur++; else break;} return {cur,bw,bl,bwStart,bwEnd,blStart,blEnd};}
function renderImg(date){ img.src=getImg(date); img.onerror=()=>{img.style.display='none';emptyImg.style.display='flex'}; img.onload=()=>{img.style.display='block';emptyImg.style.display='none'}; }
function setSeg(container,val){ [...container.querySelectorAll('button')].forEach(b=>b.classList.toggle('active',b.dataset.v===val)); }
function renderCal(){ const [y,m]=monthInput.value.split('-').map(Number); const days=new Date(y,m,0).getDate(); const first=new Date(y,m-1,1); let start=(first.getDay()+6)%7; const md=monthData(); cal.innerHTML=''; ['LUN','MAR','MIÉ','JUE','VIE','SÁB','DOM'].forEach(d=>{let e=document.createElement('div');e.className='dow';e.textContent=d;cal.appendChild(e)}); for(let i=0;i<start;i++) cal.appendChild(document.createElement('div')); for(let d=1;d<=days;d++){ const dd=String(d).padStart(2,'0'), mm=String(m).padStart(2,'0'), date=`${y}-${mm}-${dd}`; const rec=md.find(x=>x.date===date); const el=document.createElement('div'); el.className='day'; if(date===dateInput.value)el.classList.add('sel'); if(rec){ if(isPos(rec))el.classList.add('pos'); else if(isNeg(rec))el.classList.add('neg'); else el.classList.add('be'); el.innerHTML=`${d}<span class="mark"></span>`} else el.textContent=d; el.onclick=()=>selectDate(date); cal.appendChild(el); } updateMetrics(); }
function selectDate(date){ dateInput.value=date; renderImg(date); cargar(date); renderCal(); }
function guardar(){ const data={resultado:selectedResultado,direccion:direccion.value,entrada:entrada.value,relacion:relacion.value,puntos:puntos.value,sesion:sesion.value,gestion:gestion.value,feeling:feeling.value,manto:selectedManto,notas:notas.value}; localStorage.setItem(dateInput.value,JSON.stringify(data)); renderCal(); cargar(dateInput.value); alert('Guardado'); }
function cargar(date){ const data=JSON.parse(localStorage.getItem(date)||'{}'); selectedResultado=data.resultado||''; selectedManto=data.manto||''; setSeg($('resultadoSeg'),selectedResultado); setSeg($('mantoSwitch'),selectedManto); direccion.value=data.direccion||''; entrada.value=data.entrada||''; relacion.value=data.relacion||'2:1'; puntos.value=data.puntos||''; sesion.value=data.sesion||'New York'; gestion.value=data.gestion||''; feeling.value=data.feeling||''; notas.value=data.notas||''; $('detailTitle').textContent='Detalle del día - '+date; $('dayPill').textContent=data.resultado||'Sin operar'; $('dayNotes').textContent=data.notas||'Sin notas guardadas para este día.'; }
document.querySelectorAll('#resultadoSeg button').forEach(b=>b.onclick=()=>{selectedResultado=b.dataset.v;setSeg($('resultadoSeg'),selectedResultado)}); document.querySelectorAll('#mantoSwitch button').forEach(b=>b.onclick=()=>{selectedManto=b.dataset.v;setSeg($('mantoSwitch'),selectedManto)});
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));$(b.dataset.tab).classList.add('active')});
function updateMetrics(){ const md=monthData(), ad=allData(), ms=stats(md), gs=stats(ad), st=streaks(ad); $('kpiScore').textContent=ms.score+'/100'; $('kpiAsert').textContent=ms.acert+'%'; $('kpiEfec').textContent=ms.efec+'%'; $('sideStreak').textContent=st.cur+' días'; $('sideBest').textContent='Mejor racha: '+st.bw+' días'; $('monthRows').innerHTML=`<div class="row"><span>Días Operados</span><strong>${ms.operated.length}</strong></div><div class="row"><span>Días Positivos</span><strong class="g">${ms.pos.length}</strong></div><div class="row"><span>Días Negativos</span><strong class="r">${ms.neg.length}</strong></div><div class="row"><span>Break Even</span><strong>${ms.be.length}</strong></div><div class="row"><span>Mejor Día</span><strong class="g">${best(md,1)}</strong></div><div class="row"><span>Peor Día</span><strong class="r">${best(md,-1)}</strong></div><div class="row"><span>Resultado del Mes</span><strong class="${ms.net>=0?'g':'r'}">${fmt(ms.net)} pts</strong></div><div class="row"><span>Puntos ganados</span><strong class="g">+${ms.won.toFixed(1)}</strong></div><div class="row"><span>Puntos perdidos</span><strong class="r">-${ms.lost.toFixed(1)}</strong></div><div class="row"><span>Racha actual</span><strong class="g">${st.cur} días</strong></div>`; $('mantoCount').textContent=md.filter(x=>x.manto==='Si'||x.manto==='Sí').length; $('noMantoCount').textContent=md.filter(x=>x.manto==='No').length; let m=md.filter(x=>x.manto==='Si'||x.manto==='Sí'), nm=md.filter(x=>x.manto==='No'); $('mantoEfec').textContent=pct(m.filter(isPos).length,m.length)+'% efectividad'; $('noMantoEfec').textContent=pct(nm.filter(isPos).length,nm.length)+'% efectividad'; $('bestSession').textContent=topBy(md,'sesion')||'—'; $('bestEntry').textContent=topBy(md,'entrada')||'—'; $('bestSessionPts').textContent=fmt(sumBy(md,'sesion',$('bestSession').textContent))+' pts'; $('bestEntryEfec').textContent=pct(md.filter(x=>x.entrada===$('bestEntry').textContent&&isPos(x)).length,md.filter(x=>x.entrada===$('bestEntry').textContent).length)+'%'; $('bestDay').textContent=best(md,1); $('worstDay').textContent=best(md,-1); let bd=bestObj(md,1), wd=bestObj(md,-1); $('bestDayDate').textContent=bd?bd.date:'—'; $('worstDayDate').textContent=wd?wd.date:'—'; $('bestWinStreak').textContent=st.bw+' días'; $('bestWinRange').textContent=range(st.bwStart,st.bwEnd); $('bestLossStreak').textContent=st.bl+' días'; $('bestLossRange').textContent=range(st.blStart,st.blEnd); $('metricsTable').innerHTML=`<tr><th>Métrica</th><th>Mes</th><th>General</th></tr><tr><td>Acertabilidad</td><td>${ms.acert}%</td><td>${gs.acert}%</td></tr><tr><td>Efectividad</td><td>${ms.efec}%</td><td>${gs.efec}%</td></tr><tr><td>Puntos ganados</td><td>+${ms.won.toFixed(1)}</td><td>+${gs.won.toFixed(1)}</td></tr><tr><td>Puntos perdidos</td><td>-${ms.lost.toFixed(1)}</td><td>-${gs.lost.toFixed(1)}</td></tr><tr><td>Resultado neto</td><td>${fmt(ms.net)}</td><td>${fmt(gs.net)}</td></tr>`; drawLine(md); drawDonut(ms); drawSpark('spark1',md.map((x,i)=>60+i*2+(isPos(x)?8:isNeg(x)?-8:0)),'#39ff6b'); drawSpark('spark2',md.map((x,i)=>isPos(x)?80:55),'#39ff6b'); drawSpark('spark3',md.map((x,i)=>isPos(x)?70:45),'#f59e0b'); }
function fmt(n){return (n>=0?'+':'')+Number(n||0).toFixed(1)} function bestObj(d,dir){let ops=d.filter(x=>x.puntos||x.resultado); if(!ops.length)return null; return ops.sort((a,b)=>dir*(points(b)-points(a)))[0]} function best(d,dir){let o=bestObj(d,dir); return o?fmt(points(o)):'—'} function range(a,b){return a&&b?`(${a.slice(5)} - ${b.slice(5)})`:'—'} function topBy(d,key){let map={};d.forEach(x=>{if(x[key])map[x[key]]=(map[x[key]]||0)+points(x)});return Object.entries(map).sort((a,b)=>b[1]-a[1])[0]?.[0]} function sumBy(d,key,val){return d.filter(x=>x[key]===val).reduce((s,x)=>s+points(x),0)}
function drawLine(data){ const c=$('lineChart'), ctx=c.getContext('2d'), r=c.parentElement.getBoundingClientRect(); c.width=r.width*devicePixelRatio;c.height=r.height*devicePixelRatio;ctx.scale(devicePixelRatio,devicePixelRatio); const w=r.width,h=r.height; ctx.clearRect(0,0,w,h); const vals=data.length?data.map((x,i)=>60+i*1.5+(isPos(x)?12:isNeg(x)?-10:0)):[52,65,62,68,66,72,75,70,74,68,72,79,76,82,78]; ctx.strokeStyle='rgba(148,163,184,.15)';ctx.lineWidth=1;for(let i=0;i<5;i++){let y=20+i*(h-35)/4;ctx.beginPath();ctx.moveTo(10,y);ctx.lineTo(w-10,y);ctx.stroke()} const min=0,max=100; const pts=vals.map((v,i)=>[15+i*(w-35)/(vals.length-1||1), h-18-(v-min)/(max-min)*(h-40)]); let grd=ctx.createLinearGradient(0,20,0,h);grd.addColorStop(0,'rgba(57,255,107,.45)');grd.addColorStop(1,'rgba(57,255,107,0)'); ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.lineTo(pts.at(-1)[0],h-18);ctx.lineTo(pts[0][0],h-18);ctx.closePath();ctx.fillStyle=grd;ctx.fill(); ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.strokeStyle='#39ff6b';ctx.lineWidth=3;ctx.shadowBlur=12;ctx.shadowColor='#39ff6b';ctx.stroke();ctx.shadowBlur=0; let last=pts.at(-1);ctx.fillStyle='#39ff6b';roundRect(ctx,last[0]-38,last[1]-17,62,24,6,true);ctx.fillStyle='#04100a';ctx.font='bold 12px Arial';ctx.fillText(Math.round(vals.at(-1))+'/100',last[0]-30,last[1]-1); }
function drawDonut(s){ const c=$('donutChart'),ctx=c.getContext('2d'),r=c.parentElement.getBoundingClientRect(); c.width=r.width*devicePixelRatio;c.height=r.height*devicePixelRatio;ctx.scale(devicePixelRatio,devicePixelRatio); const w=r.width,h=r.height,cx=w/2,cy=h/2,rad=Math.min(w,h)/3; ctx.clearRect(0,0,w,h); const vals=[s.pos.length,s.neg.length,s.be.length], cols=['#39ff6b','#ef4444','#f59e0b']; let total=vals.reduce((a,b)=>a+b,0)||1, start=-Math.PI/2; vals.forEach((v,i)=>{let ang=v/total*Math.PI*2;ctx.beginPath();ctx.arc(cx,cy,rad,start,start+ang);ctx.lineWidth=28;ctx.strokeStyle=cols[i];ctx.stroke();start+=ang}); ctx.beginPath();ctx.arc(cx,cy,rad-18,0,Math.PI*2);ctx.fillStyle='#0b111c';ctx.fill(); $('donutLegend').innerHTML=`<div class="row"><span>Ganancias</span><strong class="g">${s.pos.length}</strong></div><div class="row"><span>Pérdidas</span><strong class="r">${s.neg.length}</strong></div><div class="row"><span>Break Even</span><strong>${s.be.length}</strong></div><div class="row"><span>Total</span><strong class="${s.net>=0?'g':'r'}">${fmt(s.net)} pts</strong></div>`; }
function drawSpark(id,vals,color){const c=$(id),ctx=c.getContext('2d'),w=c.width=c.clientWidth*devicePixelRatio,h=c.height=c.clientHeight*devicePixelRatio;ctx.scale(devicePixelRatio,devicePixelRatio); const ww=c.clientWidth,hh=c.clientHeight;ctx.clearRect(0,0,ww,hh); vals=vals.length?vals:[50,58,54,62,66,70,75]; const mn=Math.min(...vals),mx=Math.max(...vals);ctx.beginPath();vals.forEach((v,i)=>{let x=i*ww/(vals.length-1||1), y=hh-4-(v-mn)/(mx-mn||1)*(hh-8); i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.strokeStyle=color;ctx.lineWidth=2;ctx.stroke();}
function roundRect(ctx,x,y,w,h,r,fill){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();if(fill)ctx.fill();}
const today=new Date(); monthInput.value=today.toISOString().slice(0,7); dateInput.value=today.toISOString().slice(0,10); monthInput.onchange=renderCal; dateInput.onchange=()=>selectDate(dateInput.value); renderCal(); selectDate(dateInput.value); window.addEventListener('resize',updateMetrics);
</script>
</body>
</html>
